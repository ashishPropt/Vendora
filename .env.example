# ============================================================
# Vendora — Environment Config
# Copy this to .env and fill in your values
# ============================================================

# --- PostgreSQL (Local) ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/vendor_acquisition
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendor_acquisition
DB_USER=postgres
DB_PASSWORD=yourpassword

# --- Redis (Local) ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- API Keys ---
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
YELP_API_KEY=your_yelp_fusion_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional / Leave blank to skip those features
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMARTYSTREETS_AUTH_ID=
SMARTYSTREETS_AUTH_TOKEN=
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Scoring ---
SCORING_MODEL_VERSION=scoring-model-v1.0.0

# --- Discovery ---
GOOGLE_RECRAWL_DAYS=60
GOOGLE_QPS_LIMIT=10
YELP_DAILY_CALL_LIMIT=5000
DISCOVERY_TIER=1
